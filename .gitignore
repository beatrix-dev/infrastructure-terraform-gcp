# Terraform directories
.terraform/
.terraform.lock.hcl

# State files - never commit these
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
