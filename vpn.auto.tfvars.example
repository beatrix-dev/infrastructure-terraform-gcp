# VPN configuration — GCP HA VPN, dynamic tunnel count.
#
# Set vpn_peer_tunnel_ips to either 1 IP (single peer device, e.g. FortiGate)
# or 4 IPs (AWS Site-to-Site VPN) — the module deploys the matching topology
# automatically. Leave it empty for stage-1 (gateway + router only).
#
# For Terraform Cloud: set vpn_tunnel_psks as a workspace Terraform variable,
# marked Sensitive in the TFC workspace UI.

# ---------------------------------------------------------------------------
# Stage 1 (gateway only) — apply with peer vars empty to get the GCP
# interface IP(s), then give them to the peer when configuring its side.
# ---------------------------------------------------------------------------

# vpn_peer_tunnel_ips = []   # default — deploys gateway + router only

# ---------------------------------------------------------------------------
# Option A — single peer device (e.g. FortiGate), 1 tunnel
# Terminates on GCP HA VPN interface 0 only. 99.9% SLA (same as classic VPN),
# no interface-level failover — GCP interface 1 goes unused.
# ---------------------------------------------------------------------------

# vpn_peer_tunnel_ips = ["203.0.113.10"]        # FortiGate's public/WAN IP
# vpn_peer_cidr       = "10.50.0.0/16"           # FortiGate-side LAN CIDR
# vpn_peer_asn        = 65001                    # only read when vpn_routing_mode = "DYNAMIC"
# vpn_tunnel_psks     = ["set-in-tfc-as-sensitive-variable"]

# --- DYNAMIC mode (only used when vpn_routing_mode = "DYNAMIC") -----------
# vpn_bgp_tunnel_cidrs    = ["169.254.10.1/30"]  # GCP-side BGP inside IP
# vpn_bgp_tunnel_peer_ips = ["169.254.10.2"]     # FortiGate-side BGP inside IP

# ---------------------------------------------------------------------------
# Option B — AWS Site-to-Site VPN, 4 tunnels (FOUR_IPS_REDUNDANCY)
#
# Topology: 2 separate AWS VPN connections (2 tunnels each) terminate on the
# SAME GCP HA VPN gateway — one AWS connection per GCP interface IP:
#   - AWS VPN connection #1 (Customer Gateway = GCP interface 0 IP) -> tunnel 0, tunnel 1
#   - AWS VPN connection #2 (Customer Gateway = GCP interface 1 IP) -> tunnel 2, tunnel 3
#
# Where to find these values in AWS:
#   VPC > Site-to-Site VPN Connections > [each connection] > Tunnel details tab
# ---------------------------------------------------------------------------

# "Outside IP address" for each tunnel (the AWS VGW public IPs), in order:
#   [0] AWS conn #1 tunnel 1   [1] AWS conn #1 tunnel 2
#   [2] AWS conn #2 tunnel 1   [3] AWS conn #2 tunnel 2
vpn_peer_tunnel_ips = [
  "34.247.125.12",  # AWS VPN connection #1, Tunnel 1 outside IP
  "52.215.119.100", # AWS VPN connection #1, Tunnel 2 outside IP
  "18.203.3.154",   # AWS VPN connection #2, Tunnel 1 outside IP
  "52.48.207.105",  # AWS VPN connection #2, Tunnel 2 outside IP
]

# AWS VPC CIDR (allows inbound/outbound traffic through the firewall rules,
# and is also the default destination for static routes below)
vpn_peer_cidr = "172.31.0.0/16"

# BGP ASN of the AWS Virtual Private Gateway (default 64512) — only read when
# vpn_routing_mode = "DYNAMIC"
vpn_peer_asn = 64512

# ---------------------------------------------------------------------------
# Routing mode — MUST match what the peer side was created with. AWS VPN
# connections are all-static or all-dynamic (BGP); if either of your two AWS
# connections was created with routing "Static", set this to "STATIC".
# ---------------------------------------------------------------------------
vpn_routing_mode = "STATIC"

# --- STATIC mode (default here) -------------------------------------------
# One equal-priority route per tunnel per CIDR (ECMP-style failover).
# Leave empty to default to [vpn_peer_cidr]; set explicitly for a
# narrower/different destination than the whole peer CIDR.
# vpn_static_route_destination_ranges = ["172.31.0.0/16"]
# vpn_static_route_priority           = 1000

# --- DYNAMIC mode (only used when vpn_routing_mode = "DYNAMIC") -----------
# "Inside IP addresses > Customer Gateway" — the GCP-side BGP address with /30,
# one entry per tunnel, in the same order as vpn_peer_tunnel_ips:
# vpn_bgp_tunnel_cidrs = [
#   "169.254.235.137/30", # AWS conn #1 tunnel 1
#   "169.254.37.197/30",  # AWS conn #1 tunnel 2
#   "169.254.96.42/30",   # AWS conn #2 tunnel 1
#   "169.254.89.254/30",  # AWS conn #2 tunnel 2
# ]

# "Inside IP addresses > Virtual Private Gateway" — the AWS-side BGP peer IP,
# one entry per tunnel, in the same order as vpn_peer_tunnel_ips:
# vpn_bgp_tunnel_peer_ips = [
#   "169.254.235.138", # AWS conn #1 tunnel 1
#   "169.254.37.198",  # AWS conn #1 tunnel 2
#   "169.254.96.41",   # AWS conn #2 tunnel 1
#   "169.254.89.253",  # AWS conn #2 tunnel 2
# ]

# PSKs, one per tunnel in the same order as vpn_peer_tunnel_ips — set as a
# SENSITIVE Terraform variable in TFC, never commit real values
# vpn_tunnel_psks = [
#   "set-in-tfc-as-sensitive-variable", # AWS conn #1 tunnel 1
#   "set-in-tfc-as-sensitive-variable", # AWS conn #1 tunnel 2
#   "set-in-tfc-as-sensitive-variable", # AWS conn #2 tunnel 1
#   "set-in-tfc-as-sensitive-variable", # AWS conn #2 tunnel 2
# ]
